{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "vite build",
    "dev:standalone": "vite --host 0.0.0.0 --port 3000",
    "preview:standalone": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "NODE_ENV=production node --import tsx server/index.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test src/*.test.ts server/*.test.ts",
    "verify:vercel": "node scripts/smoke-vercel.mjs",
    "verify:production": "npm run build && node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
