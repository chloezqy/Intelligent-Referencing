# Local development: npm run dev. No external AI/backend key is needed.
PORT=3000
ROOM_DATA_DIR=.data
# Direct localhost access should not trust forwarded headers.
TRUST_PROXY_HOPS=0
# Optional fixed browser origin (no trailing path). Leave unset for localhost/LAN.
# PUBLIC_ORIGIN=http://localhost:3000

# Render production: NODE_ENV=production, TRUST_PROXY_HOPS=1,
# ROOM_DATA_DIR=/var/data/smart-reference with a disk mounted at /var/data.
# Do not set PORT on Render/Railway: use the provider's PORT.
# RENDER_EXTERNAL_URL is detected automatically; set PUBLIC_ORIGIN=https://YOUR-DOMAIN
# if using a custom domain. Railway: RAILWAY_PUBLIC_DOMAIN is detected automatically.

# Semantic AI: leave disabled until you approve a paid live test.
# Server-side only. NEVER use VITE_ prefixes for secrets.
AI_ENABLED=false
# OPENAI_API_KEY=your-private-key
OPENAI_MODEL=gpt-4.1-mini
# npm run dev keeps AI restricted to loopback/local browser requests.
# Vercel uses the same variables in its dashboard; see docs/VERCEL.md.
# Vercel supplies VERCEL and deployment host variables; protect enabled deployments.
# PUBLIC_ORIGIN=https://your-custom-domain.example (optional on Vercel)
# Local AI usage: npm run dev (port 3000) serves both frontend and this endpoint.
# A static-only preview still supports referencing, but cannot run private API calls.
